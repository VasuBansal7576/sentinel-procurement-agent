# Application
SENTINEL_ENVIRONMENT=development
SENTINEL_LOG_LEVEL=INFO
SENTINEL_API_HOST=0.0.0.0
SENTINEL_API_PORT=8000
SENTINEL_WEB_ORIGIN=http://localhost:5173
SENTINEL_PERSISTENCE_MODE=postgres
SENTINEL_AUTO_MIGRATE=true

# Persistence and durable execution
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
SENTINEL_TEMPORAL_ADDRESS=localhost:7233
SENTINEL_TEMPORAL_NAMESPACE=default
SENTINEL_OBJECT_STORE_ENDPOINT=http://localhost:9000
SENTINEL_OBJECT_STORE_BUCKET=sentinel
SENTINEL_OBJECT_STORE_ACCESS_KEY=sentinel
SENTINEL_OBJECT_STORE_SECRET_KEY=sentinel-local-only

# Provider selection. Development defaults require no external credentials.
SENTINEL_MODEL_PROVIDER=fake
SENTINEL_EMAIL_PROVIDER=fake
SENTINEL_EMAIL_SENDER=onboarding@resend.dev
SENTINEL_CONTROLLED_RECIPIENT=
SENTINEL_CREDENTIAL_GATE=fake-only

# Optional deterministic operator demo. These controls are rejected unless
# DEMO_MODE is true and are always rejected in production.
SENTINEL_DEMO_MODE=false
SENTINEL_DEMO_STEP_DELAY_MS=0
SENTINEL_DEMO_FAILURE_STEP=

# Live credentials are intentionally blank and must never be committed.
OPENAI_API_KEY=
RESEND_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
